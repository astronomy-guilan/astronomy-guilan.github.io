---
const links = [
  { href: "/", label: "خانه" },
  { href: "/news/", label: "اخبار" },
  { href: "/articles/", label: "مقالات" },
  { href: "/nasa-weekly/", label: "NASA Weekly" },
  { href: "/events/", label: "رویدادها" },
  { href: "/gallery/", label: "گالری" },
  { href: "/about/", label: "درباره انجمن" },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <div class="col brand-col">
      <a href="/" class="brand">
        <img src="/logo-light.png" alt="لوگوی انجمن نجوم" />
        <span class="names">
          <strong>انجمن نجوم دانشگاه گیلان</strong>
          <small>Astronomy Society · University of Guilan</small>
        </span>
      </a>
      <p class="tagline">با هم، برای کشف، یادگیری و گسترش دانش نجوم.</p>
    </div>

    <div class="col">
      <h3>دسترسی سریع</h3>
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="col">
      <h3>تماس با ما</h3>
      <ul>
        <li>دانشگاه گیلان، رشت</li>
        <li>
          <a href="https://t.me/Astronomy_Guilan" target="_blank" rel="noopener">
            تلگرام: <span class="ltr">@Astronomy_Guilan</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/astronomy-guilan" target="_blank" rel="noopener">
            گیت‌هاب: <span class="ltr">astronomy-guilan</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="copy">
    <span class="ltr">© {year} Astronomy Society · University of Guilan. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: #081228;
    color: #c8d6f0;
    border-top: 1px solid rgba(120, 160, 255, 0.15);
    margin-top: 3rem;
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
  }
  .brand img {
    height: 48px;
    width: auto;
  }
  .names {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .names small {
    font-size: 0.7rem;
    color: #9db3d9;
    direction: ltr;
    text-align: right;
  }
  .tagline {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    color: #9db3d9;
  }
  h3 {
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
    color: #fff;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.88rem;
  }
  a {
    color: #c8d6f0;
  }
  a:hover {
    color: #fff;
  }
  .ltr {
    direction: ltr;
    unicode-bidi: isolate;
  }
  .copy {
    border-top: 1px solid rgba(120, 160, 255, 0.15);
    padding: 1rem;
    text-align: center;
    font-size: 0.75rem;
    color: #8296bd;
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1.6fr 1fr 1.2fr;
    }
  }
</style>
