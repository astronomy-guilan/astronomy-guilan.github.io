---
const links = [
  { href: "/", label: "خانه" },
  { href: "/news/", label: "اخبار" },
  { href: "/articles/", label: "مقالات" },
  { href: "/nasa-weekly/", label: "NASA Weekly" },
  { href: "/events/", label: "رویدادها" },
  { href: "/gallery/", label: "گالری" },
  { href: "/about/", label: "درباره انجمن" },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="bar">
    <a href="/" class="brand">
      <img src="/logo-light.png" alt="لوگوی انجمن نجوم" />
      <span class="names">
        <strong>انجمن نجوم دانشگاه گیلان</strong>
        <small>Astronomy Society · University of Guilan</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="منوی اصلی">
      {links.map((l) => (
        <a href={l.href} class:list={[{ active: path === l.href }]}>{l.label}</a>
      ))}
    </nav>

    <button id="menu-btn" class="menu-btn" aria-label="باز کردن منو" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="منوی موبایل">
      {links.map((l) => (
        <a href={l.href} class:list={[{ active: path === l.href }]}>{l.label}</a>
      ))}
    </nav>
    <div class="lang">
      <span class="on">FA</span>
      <span>EN</span>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.hasAttribute("hidden");
    if (open) menu?.removeAttribute("hidden");
    else menu?.setAttribute("hidden", "");
    btn.setAttribute("aria-expanded", String(!!open));
    btn.classList.toggle("open", !!open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 18, 40, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(120, 160, 255, 0.15);
  }
  .bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
    text-decoration: none;
  }
  .brand img {
    height: 44px;
    width: auto;
  }
  .names {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .names strong {
    font-size: 0.95rem;
  }
  .names small {
    font-size: 0.65rem;
    color: #9db3d9;
    direction: ltr;
    text-align: right;
  }
  .desktop-nav {
    display: none;
    gap: 1.4rem;
  }
  .desktop-nav a {
    color: #c8d6f0;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
  }
  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: #fff;
    border-bottom-color: #4d8dff;
  }
  .menu-btn {
    background: none;
    border: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
  }
  .menu-btn span {
    width: 24px;
    height: 2px;
    background: #fff;
    transition: transform 0.2s, opacity 0.2s;
  }
  .menu-btn.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-btn.open span:nth-child(2) {
    opacity: 0;
  }
  .menu-btn.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .mobile-menu {
    border-top: 1px solid rgba(120, 160, 255, 0.15);
    padding: 0.5rem 1rem 1rem;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu nav a {
    color: #c8d6f0;
    text-decoration: none;
    padding: 0.85rem 0.5rem;
    border-radius: 8px;
  }
  .mobile-menu nav a.active {
    background: rgba(77, 141, 255, 0.15);
    color: #fff;
  }
  .lang {
    margin-top: 0.8rem;
    display: inline-flex;
    border: 1px solid rgba(120, 160, 255, 0.3);
    border-radius: 999px;
    overflow: hidden;
    font-size: 0.8rem;
    color: #9db3d9;
  }
  .lang span {
    padding: 0.35rem 1rem;
  }
  .lang .on {
    background: #2f6bff;
    color: #fff;
  }
  @media (min-width: 900px) {
    .desktop-nav {
      display: flex;
    }
    .menu-btn,
    .mobile-menu {
      display: none !important;
    }
  }
</style>
